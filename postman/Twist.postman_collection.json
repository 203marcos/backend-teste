{
  "info": {
    "_postman_id": "d6b88457-11e0-566c-933a-83b5d86ddf34",
    "name": "Twist API",
    "description": "Coleção da API do Twist.\n\n1. Importe também o ambiente `Twist.local.postman_environment.json` e selecione **Twist - Local**.\n2. Rode **Autenticação → Cadastro** e **Login**: os tokens ficam salvos nas variáveis da coleção.\n3. As demais requisições usam o token automaticamente. Para rodar tudo, use **Run collection**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Autenticação",
      "description": "Cadastro, login e renovação do token. O login salva os tokens nas variáveis da coleção.",
      "item": [
        {
          "name": "Cadastro",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set(\"user_id\", pm.response.json().id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/accounts/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "register"
              ]
            },
            "description": "Cria o usuário `{{username}}`. Envio em multipart/form-data; o avatar é opcional.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "{{username}}@example.com",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "birth_date",
                  "value": "2000-01-15",
                  "type": "text"
                },
                {
                  "key": "first_name",
                  "value": "Twist",
                  "type": "text"
                },
                {
                  "key": "last_name",
                  "value": "Demo",
                  "type": "text"
                },
                {
                  "key": "bio",
                  "value": "Conta de demonstração",
                  "type": "text",
                  "disabled": true
                },
                {
                  "key": "avatar",
                  "type": "file",
                  "src": [],
                  "disabled": true,
                  "description": "Opcional: JPEG, PNG ou WebP até 5MB"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set(\"access_token\", pm.response.json().access); }",
                  "if (pm.response.code < 300) { pm.collectionVariables.set(\"refresh_token\", pm.response.json().refresh); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/accounts/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "login"
              ]
            },
            "description": "`identifier` aceita e-mail ou username. Salva `access_token` e `refresh_token`.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Renovar token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 2xx\", () => pm.expect(pm.response.code).to.be.within(200, 299));",
                  "if (pm.response.code < 300) { pm.collectionVariables.set(\"access_token\", pm.response.json().access); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/accounts/token/refresh/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "accounts",
                "token",
                "refresh"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
